{
  "gateway": {
    "port": 10000,
    "bind": "lan",
    "auth": { "mode": "token" },
    "controlUi": {
      "allowedOrigins": ["https://openclaw-render.onrender.com"]
    }
  },
  "agents": {
    "defaults": {
      "workspace": "/app/workspace"
    }
  },
  "plugins": {
    "slots": { "memory": "none" },
    "load": { "paths": ["/app/plugins/graphify-ponytail-peak-manager"] },
    "allow": ["graphify-ponytail-peak-manager"],
    "entries": { "graphify-ponytail-peak-manager": { "enabled": true } }
  }
}
